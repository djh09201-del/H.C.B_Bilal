<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>H.C.B Car Racing</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: #111;
      color: white;
      font-family: Arial, sans-serif;
      text-align: center;
      overflow: hidden;
    }

    /* START SCREEN */
    #startScreen {
      position: fixed;
      inset: 0;
      background: linear-gradient(135deg, #000, #222);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 10;
    }

    #startScreen img {
      width: 120px;
      height: 120px;
      object-fit: cover;
      border-radius: 50%;
      border: 4px solid gold;
      margin-bottom: 15px;
    }

    #startScreen h1 {
      color: gold;
      font-size: 35px;
      margin-bottom: 8px;
    }

    #startScreen p {
      color: #ddd;
      margin-bottom: 25px;
    }

    #startBtn {
      background: gold;
      color: black;
      border: none;
      padding: 15px 40px;
      border-radius: 30px;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
    }

    /* GAME */
    #game {
      display: none;
      position: relative;
      width: 100vw;
      height: 100vh;
      background: #333;
      overflow: hidden;
    }

    #road {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: 320px;
      height: 100%;
      background: #555;
      border-left: 6px solid white;
      border-right: 6px solid white;
    }

    .line {
      position: absolute;
      width: 8px;
      height: 80px;
      background: white;
      left: 50%;
      transform: translateX(-50%);
    }

    #player {
      position: absolute;
      width: 55px;
      height: 95px;
      background: red;
      border-radius: 12px;
      bottom: 100px;
      left: calc(50% - 27px);
      border: 3px solid white;
    }

    .enemy {
      position: absolute;
      width: 55px;
      height: 95px;
      background: blue;
      border-radius: 12px;
      border: 3px solid white;
    }

    #score {
      position: absolute;
      top: 15px;
      left: 15px;
      z-index: 5;
      font-size: 22px;
      font-weight: bold;
    }

    /* TOUCH BUTTONS */
    #controls {
      position: absolute;
      bottom: 20px;
      width: 100%;
      display: flex;
      justify-content: center;
      gap: 80px;
      z-index: 5;
    }

    .controlBtn {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      border: 2px solid white;
      background: rgba(0,0,0,0.7);
      color: white;
      font-size: 30px;
    }
  </style>
</head>

<body>

  <!-- START SCREEN -->
  <div id="startScreen">

    <!-- PHOTO KEE -->
    <img src="profile.jpg" alt="H.C.B">

    <!-- MAQAA KEE -->
    <h1>H.C.B</h1>

    <p>Welcome to H.C.B Car Racing</p>

    <button id="startBtn">START GAME</button>
  </div>

  <!-- GAME -->
  <div id="game">

    <div id="score">Score: 0</div>

    <div id="road">

      <div class="line" style="top: 0;"></div>
      <div class="line" style="top: 180px;"></div>
      <div class="line" style="top: 360px;"></div>
      <div class="line" style="top: 540px;"></div>

      <div id="player"></div>

    </div>

    <!-- TOUCH CONTROLS -->
    <div id="controls">
      <button class="controlBtn" id="leftBtn">⬅️</button>
      <button class="controlBtn" id="rightBtn">➡️</button>
    </div>

  </div>

  <script>
    const startScreen = document.getElementById("startScreen");
    const startBtn = document.getElementById("startBtn");
    const game = document.getElementById("game");
    const player = document.getElementById("player");
    const scoreText = document.getElementById("score");

    const leftBtn = document.getElementById("leftBtn");
    const rightBtn = document.getElementById("rightBtn");

    let playerX;
    let score = 0;
    let gameRunning = false;

    startBtn.addEventListener("click", () => {
      startScreen.style.display = "none";
      game.style.display = "block";

      playerX = window.innerWidth / 2 - 27;
      player.style.left = playerX + "px";

      score = 0;
      gameRunning = true;

      createEnemy();
      gameLoop();
    });

    function moveLeft() {
      if (!gameRunning) return;

      playerX -= 25;

      if (playerX < 170) {
        playerX = 170;
      }

      player.style.left = playerX + "px";
    }

    function moveRight() {
      if (!gameRunning) return;

      playerX += 25;

      if (playerX > window.innerWidth - 225) {
        playerX = window.innerWidth - 225;
      }

      player.style.left = playerX + "px";
    }

    leftBtn.addEventListener("touchstart", moveLeft);
    rightBtn.addEventListener("touchstart", moveRight);

    leftBtn.addEventListener("click", moveLeft);
    rightBtn.addEventListener("click", moveRight);

    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") moveLeft();
      if (e.key === "ArrowRight") moveRight();
    });

    function createEnemy() {

      if (!gameRunning) return;

      const enemy = document.createElement("div");

      enemy.classList.add("enemy");

      enemy.style.top = "-120px";

      const roadLeft = window.innerWidth / 2 - 160;

      const randomX =
        roadLeft + Math.random() * 265;

      enemy.style.left = randomX + "px";

      game.appendChild(enemy);

      let enemyY = -120;

      const moveEnemy = setInterval(() => {

        if (!gameRunning) {
          clearInterval(moveEnemy);
          enemy.remove();
          return;
        }

        enemyY += 5;

        enemy.style.top = enemyY + "px";

        const playerRect = player.getBoundingClientRect();
        const enemyRect = enemy.getBoundingClientRect();

        if (
          playerRect.left < enemyRect.right &&
          playerRect.right > enemyRect.left &&
          playerRect.top < enemyRect.bottom &&
          playerRect.bottom > enemyRect.top
        ) {

          gameOver();

          clearInterval(moveEnemy);
          return;
        }

        if (enemyY > window.innerHeight) {

          score++;

          scoreText.textContent =
            "Score: " + score;

          enemy.remove();

          clearInterval(moveEnemy);
        }

      }, 20);
    }

    function gameLoop() {

      if (!gameRunning) return;

      setTimeout(() => {
        createEnemy();
        gameLoop();
      }, 1200);
    }

    function gameOver() {

      gameRunning = false;

      alert(
        "Game Over!\n\nH.C.B Score: " + score
      );

      location.reload();
    }
  </script>

</body>
</html>
